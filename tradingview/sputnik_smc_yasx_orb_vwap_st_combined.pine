vwapLineWidth = input.int(2, "VWAP line width", minval=1, maxval=5, group=groupTrend, display=display.none)
autoTuneSensitivity = input.bool(true, "Auto-adjust sensitivity from trend/range", group=groupTrend, display=display.none)
manualSensitivity = input.int(12, "Manual sensitivity when auto is off", minval=5, maxval=24, group=groupTrend, display=display.none)
emaFastLen = input.int(20, "Fast EMA", minval=1, group=groupTrend, display=display.none)
emaMidLen = input.int(50, "Mid EMA", minval=1, group=groupTrend, display=display.none)
emaSlowLen = input.int(100, "Slow EMA", minval=1, group=groupTrend, display=display.none)

//@version=6
indicator("SPUTNIK SMC + YASX ORB VWAP + Evasive ST", shorttitle="SPUTNIK SMC+YASX", overlay=true, behind_chart=false, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// Combined from:
// 1. SPUTNIK SMC Price Action Visual Engine
// 2. Yuri ASX ORB VWAP + Evasive SuperTrend
// 3. Madrid Moving Average Ribbon colour logic
//
// Watch-only decision-support overlay. No broker execution logic is included.
// Uses public formulas: pivots, BOS/CHoCH, HH/HL/LH/LL, equal highs/lows,
// sweeps, FVGs, order-block proxy zones, ATR trail, EMA/VWAP context,
// ASX/session ORB, squeeze, Evasive SuperTrend, and pivot geometry.

// ------------------------- Locked chart defaults
groupQuick = "00. Locked Chart Defaults"
showMadridRibbon = input.bool(true, "Show Madrid ribbon", tooltip="Default ON to match the locked Sputnik chart view.", group=groupQuick, display=display.none)
madridUseExponential = input.bool(true, "Madrid uses EMA", tooltip="ON matches the original Madrid Ribbon default. Turn off for SMA ribbon.", group=groupQuick, display=display.none)
showOrbVwapPack = input.bool(true, "Show ORB + VWAP pack", tooltip="Fast visual toggle for session shade, opening-range box/lines/labels, and VWAP plot.", group=groupQuick, display=display.none)

// ------------------------- MA ribbon quick colours
groupRibbon = "00A. MA Ribbon Quick Colours"
ribbonUseCustomColours = input.bool(false, "Use custom ribbon colours", tooltip="OFF locks the ribbon to the exact candle colours. Turn ON to use the three ribbon colour inputs.", group=groupRibbon, display=display.none)
ribbonBullColorInput = input.color(color.rgb(20, 142, 255), "Ribbon bullish colour", group=groupRibbon, display=display.none)
ribbonBearColorInput = input.color(color.rgb(211, 22, 74), "Ribbon bearish colour", group=groupRibbon, display=display.none)
ribbonNeutralColorInput = input.color(color.rgb(207, 212, 222), "Ribbon neutral/doji colour", group=groupRibbon, display=display.none)

// ------------------------- Smart Money / Structure inputs
groupStructure = "01. Smart Money / Structure"
showStructure = input.bool(true, "Show HH/HL/LH/LL", group=groupStructure, display=display.none)
showBosChoch = input.bool(true, "Show BOS / CHoCH", group=groupStructure, display=display.none)
showLiquidity = input.bool(true, "Show liquidity grabs / equal highs-lows", group=groupStructure, display=display.none)
showFvg = input.bool(true, "Show fair value gaps", group=groupStructure, display=display.none)
showOrderBlocks = input.bool(true, "Show order-block proxy zones", group=groupStructure, display=display.none)
showLiveRangeZones = input.bool(true, "Show premium / discount range zones", group=groupStructure, display=display.none)
showRangeGuideLines = input.bool(false, "Show range guide lines", group=groupStructure, display=display.none)
showStructureEventLines = input.bool(false, "Show BOS/liquidity horizontal guide lines", group=groupStructure, display=display.none)
showZoneText = input.bool(false, "Show order-block text labels", group=groupStructure, display=display.none)
showFvgText = input.bool(false, "Show FVG text inside boxes", group=groupStructure, display=display.none)
showRangeZoneLabels = input.bool(true, "Label premium / equilibrium / discount range", group=groupStructure, display=display.none)
showEquilibriumLabel = input.bool(true, "Label equilibrium zone", group=groupStructure, display=display.none)
priceActionTextOnly = input.bool(true, "Price-action labels as coloured text", group=groupStructure, display=display.none)
pivotLen = input.int(5, "Structure pivot length", minval=2, maxval=30, group=groupStructure, display=display.none)
equalAtrTol = input.float(0.18, "Equal high/low tolerance ATR", minval=0.01, step=0.01, group=groupStructure, display=display.none)
sweepLookback = input.int(12, "Liquidity sweep lookback", minval=3, maxval=100, group=groupStructure, display=display.none)
zoneExtend = input.int(34, "Zone extension bars", minval=8, maxval=160, group=groupStructure, display=display.none)
maxZones = input.int(6, "Max visible zones", minval=2, maxval=30, group=groupStructure, display=display.none)
zoneFillTransparency = input.int(82, "Structure zone transparency", minval=55, maxval=100, group=groupStructure, display=display.none)
fvgFillTransparency = input.int(84, "FVG zone transparency", minval=55, maxval=100, group=groupStructure, display=display.none)
rangeFillTransparency = input.int(86, "Premium/discount transparency", minval=65, maxval=100, group=groupStructure, display=display.none)
zoneBorderTransparency = input.int(55, "Zone border transparency", minval=0, maxval=100, group=groupStructure, display=display.none)
structureLineWidth = input.int(2, "BOS / liquidity line width", minval=1, maxval=8, group=groupStructure, display=display.none)
rangeLineWidth = input.int(3, "Support / resistance line width", minval=1, maxval=10, group=groupStructure, display=display.none)
rangeZoneWidth = input.int(42, "Visible range-zone width", minval=12, maxval=140, group=groupStructure, display=display.none)
rangeZoneForward = input.int(10, "Range-zone forward bars", minval=0, maxval=80, group=groupStructure, display=display.none)
rangeZoneGapAtr = input.float(0.08, "Range-zone separation ATR", minval=0.0, maxval=0.5, step=0.01, group=groupStructure, display=display.none)

// ------------------------- Trend / VWAP / signal inputs
groupTrend = "02. Trend / VWAP / Signals"

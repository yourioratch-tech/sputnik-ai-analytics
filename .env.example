# Generate each value independently: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SPUTNIK_TV_WEBHOOK_ID=replace-with-unguessable-path-id
SPUTNIK_TV_SHARED_SECRET=replace-with-tradingview-payload-secret
SPUTNIK_NEWS_WEBHOOK_ID=replace-with-news-webhook-path-id
SPUTNIK_NEWS_SHARED_SECRET=replace-with-news-payload-secret
SPUTNIK_API_KEY=replace-with-read-only-chatgpt-key
SPUTNIK_OPERATOR_KEY=replace-with-bounded-chatgpt-work-key
SPUTNIK_ADMIN_KEY=replace-with-worker-admin-key

SPUTNIK_DATABASE_PATH=/data/sputnik.sqlite3
SPUTNIK_REPORTS_DIR=/app/reports/jobs
SPUTNIK_CONFIG_DIR=/app/configs
SPUTNIK_PUBLIC_BASE_URL=https://markets.example.com
SPUTNIK_MAX_DATA_AGE_SECONDS=900
SPUTNIK_LOG_LEVEL=INFO
SPUTNIK_SCHEDULER_ENABLED=true
SPUTNIK_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
SPUTNIK_GRANITE_WORKERS=4
SPUTNIK_GRANITE_TIMEOUT_SECONDS=180
# Optional comma-separated source restriction, for example: reuters.com,asx.com.au
SPUTNIK_NEWS_ALLOWED_DOMAINS=

# Optional Docker Compose Cloudflare Tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=
